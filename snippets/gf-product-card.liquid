
{%- assign second_media = product.media[1] -%}
<article class="gf-card">
  <a class="gf-card__media" href="{{ product.url }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.title }}
      {%- if second_media -%}{{ second_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.title }}{%- endif -%}
    {%- else -%}<div style="width:100%;height:100%;background:#e7ebf1"></div>{%- endif -%}
    {%- if product.tags contains 'nuevo' or product.tags contains 'bestseller' -%}<span class="gf-card__badge">{{ product.tags | first }}</span>{%- endif -%}
    <button type="button" class="gf-card__heart" data-gf-favorite="{{ product.handle }}" aria-label="Guardar {{ product.title }}">♡</button>
  </a>
  <div class="gf-card__body">
    <div class="gf-card__meta"><span>{{ product.type | default: 'Regalo personalizado' }}</span><span class="gf-card__rating">★ {{ product.metafields.reviews.rating.value | default: '5.0' }}</span></div>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="gf-card__tagline">{{ product.description | strip_html | truncate: 92 }}</p>
    <div class="gf-card__bottom">
      <div><span class="gf-price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="gf-compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
      <a class="gf-card__button" href="{{ product.url }}">{%- if product.tags contains 'personalizable' -%}✦ Grabar{%- else -%}+ Agregar{%- endif -%}</a>
    </div>
  </div>
</article>
