
{{ 'gf-styles.css' | asset_url | stylesheet_tag }}
<section class="gf-section gf-hero" id="gf-hero-{{ section.id }}">
  <span class="gf-hero__glow gf-hero__glow--coral"></span><span class="gf-hero__glow gf-hero__glow--mint"></span>
  <div class="gf-container gf-hero__grid">
    <div class="gf-hero__copy">
      <div class="gf-pill">✦ {{ section.settings.eyebrow }} <b>{{ section.settings.badge }}</b></div>
      <h1>{{ section.settings.heading | escape | replace: 'emociones', '<em>emociones</em>' }}</h1>
      <p class="gf-hero__lead">{{ section.settings.subheading }}</p>
      <div class="gf-actions"><a class="gf-button gf-button--coral" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} →</a><a class="gf-button gf-button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div>
      <div class="gf-trust">
        {%- for block in section.blocks -%}<div class="gf-trust__item" {{ block.shopify_attributes }}><span class="gf-trust__icon">{{ block.settings.icon }}</span><div><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></div></div>{%- endfor -%}
      </div>
    </div>
    <div class="gf-hero__card">
      <span class="gf-hero__badge">{{ section.settings.card_badge }}</span>
      {%- if section.settings.card_image -%}{{ section.settings.card_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '540,720,1000', alt: section.settings.card_image.alt | default: section.settings.card_title }}{%- else -%}<div style="aspect-ratio:1;border-radius:20px;background:linear-gradient(135deg,#273a63,#101d3a);display:grid;place-items:center;color:#38FFD0;font-size:72px">✦</div>{%- endif -%}
      <div class="gf-hero__caption"><strong>{{ section.settings.card_title }}</strong><small>{{ section.settings.card_subtitle }}</small></div>
      <div class="gf-mini-row"><span>🐾<br>{{ section.settings.mini_1 }}</span><span>🎀<br>{{ section.settings.mini_2 }}</span><span>💌<br>{{ section.settings.mini_3 }}</span></div>
    </div>
  </div>
</section>
{% schema %}{"name":"GF · Héroe Gifti","tag":"section","class":"gf-hero-section","settings":[{"type":"text","id":"eyebrow","label":"Etiqueta","default":"Regalos curados & detalles que tocan el alma"},{"type":"text","id":"badge","label":"País o sello","default":"México"},{"type":"text","id":"heading","label":"Titular","default":"Regalos que hablan, emociones que trascienden."},{"type":"textarea","id":"subheading","label":"Descripción","default":"Diseñamos piezas únicas grabadas con láser, termos de alta gama, hoodies artísticos y detalles personalizados para celebrar el amor hacia tus mascotas y seres queridos."},{"type":"text","id":"primary_label","label":"Botón principal","default":"Arma tu regalo en 3 pasos"},{"type":"url","id":"primary_link","label":"Enlace principal"},{"type":"text","id":"secondary_label","label":"Botón secundario","default":"Explorar catálogo"},{"type":"url","id":"secondary_link","label":"Enlace secundario"},{"type":"image_picker","id":"card_image","label":"Imagen destacada"},{"type":"text","id":"card_badge","label":"Sello sobre imagen","default":"Personalizable ✨"},{"type":"text","id":"card_title","label":"Título de imagen","default":"Tu historia, grabada para siempre"},{"type":"text","id":"card_subtitle","label":"Subtítulo de imagen","default":"Nombre, dedicatoria y empaque de lujo"},{"type":"text","id":"mini_1","label":"Mini beneficio 1","default":"Madera fina"},{"type":"text","id":"mini_2","label":"Mini beneficio 2","default":"Caja regalo"},{"type":"text","id":"mini_3","label":"Mini beneficio 3","default":"Nota incluida"}],"blocks":[{"type":"trust","name":"Confianza","settings":[{"type":"text","id":"icon","label":"Icono","default":"★"},{"type":"text","id":"title","label":"Título","default":"4.9/5 estrellas"},{"type":"text","id":"text","label":"Texto","default":"+10,000 felices"}]}],"max_blocks":3,"presets":[{"name":"GF · Héroe Gifti","blocks":[{"type":"trust"},{"type":"trust","settings":{"icon":"⚡","title":"Envío rápido","text":"Todo México"}},{"type":"trust","settings":{"icon":"✦","title":"Caja de lujo","text":"Listón & sello"}}]}]}{% endschema %}
