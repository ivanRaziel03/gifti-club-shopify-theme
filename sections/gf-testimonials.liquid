
{{ 'gf-styles.css' | asset_url | stylesheet_tag }}
<section class="gf-section gf-reviews"><div class="gf-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="gf-reviews__head"><div class="gf-stars">★★★★★</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div><div class="gf-review-grid">{%- for block in section.blocks -%}<article class="gf-review" {{ block.shopify_attributes }}><div><div class="gf-stars">★★★★★</div><blockquote>“{{ block.settings.quote }}”</blockquote></div><div class="gf-review__author"><strong>{{ block.settings.name }} · Compra verificada</strong><small>{{ block.settings.location }} · {{ block.settings.detail }}</small></div></article>{%- endfor -%}</div></div></section>
{% schema %}{"name":"GF · Testimonios","tag":"section","settings":[{"type":"text","id":"heading","label":"Título","default":"Lo que dicen quienes ya regalaron amor"},{"type":"textarea","id":"subheading","label":"Descripción","default":"Más de 10,000 regalos entregados con sonrisas y lágrimas de emoción en toda la República Mexicana."},{"type":"range","id":"padding_top","label":"Espacio superior","min":24,"max":120,"step":8,"default":80},{"type":"range","id":"padding_bottom","label":"Espacio inferior","min":24,"max":120,"step":8,"default":80}],"blocks":[{"type":"review","name":"Testimonio","settings":[{"type":"textarea","id":"quote","label":"Testimonio","default":"El detalle superó todas mis expectativas y llegó precioso."},{"type":"text","id":"name","label":"Nombre","default":"Valeria R."},{"type":"text","id":"location","label":"Ubicación","default":"Ciudad de México"},{"type":"text","id":"detail","label":"Detalle","default":"Para Koda"}]}],"max_blocks":3,"presets":[{"name":"GF · Testimonios","blocks":[{"type":"review","settings":{"quote":"Pedí el llavero con el grabado de mi perrito y superó por completo mis expectativas.","name":"Valeria R.","location":"Ciudad de México","detail":"Para Husky Koda"}},{"type":"review","settings":{"quote":"El regalo perfecto: el empaque, el diseño y la calidad se sienten de altísima calidad.","name":"Carlos M.","location":"Guadalajara, JAL","detail":"Regalo de aniversario"}},{"type":"review","settings":{"quote":"La placa llegó impecable y el grabado es súper legible. Volveré a comprar.","name":"Sofía L.","location":"Monterrey, NL","detail":"Para Rocky"}}]}]}{% endschema %}
