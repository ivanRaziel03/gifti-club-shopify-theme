<section class="page-width section-pad"><header><h1 class="section-heading">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</header>{% paginate collection.products by section.settings.products_per_page %}<div class="collection-grid">{% for product in collection.products %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 640 | image_tag: widths: '240, 360, 480, 640', sizes: '(min-width: 760px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | escape }}{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.price | money }}</p></article>{% else %}<p>Aún no hay productos en esta colección.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
<style>.collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.product-card a{text-decoration:none}.product-card img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px}.product-card h2{color:var(--navy);font-size:1.05rem}@media(max-width:760px){.collection-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}}</style>
{% schema %}{"name":"Colección principal","settings":[{"type":"range","id":"products_per_page","label":"Productos por página","min":4,"max":24,"step":4,"default":12}],"presets":[{"name":"Colección principal"}]}{% endschema %}
