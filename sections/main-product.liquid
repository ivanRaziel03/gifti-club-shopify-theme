<pet-product-form><div class="page-width product-layout"><div class="product-gallery">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 760px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt | escape }}{% endif %}</div><div class="product-info"><p class="muted">Personalizado para tu familia</p><h1>{{ product.title | escape }}</h1><div class="price" data-variant-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% if section.settings.show_description %}<div>{{ product.description }}</div>{% endif %}<ul class="trust-list"><li>Pagos seguros</li><li>OXXO y SPEI*</li><li>Meses sin intereses*</li><li>Garantía según políticas</li></ul><form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product-form">{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>{% else %}<div class="field"><label for="VariantSelect">Opción</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} (Agotado){% endunless %}</option>{% endfor %}</select></div>{% endif %}{% if section.settings.enable_species %}<div class="field"><label for="PetSpecies">¿Para quién es?</label><select id="PetSpecies" name="properties[Especie]"><option>Perro</option><option>Gato</option></select></div>{% endif %}{% if section.settings.enable_name %}<div class="field"><label for="PetName">Nombre de tu mascota</label><input id="PetName" name="properties[Nombre de la mascota]" maxlength="40" placeholder="Ej. Luna"></div>{% endif %}{% if section.settings.enable_photo %}<div class="field"><label for="PetPhoto">Foto de referencia (opcional)</label><input id="PetPhoto" name="properties[Foto de referencia]" type="file" accept="image/*"><small>Sube una imagen clara. El archivo se adjunta al artículo del pedido.</small></div>{% endif %}{% if section.settings.enable_engraving %}<div class="field"><label for="Engraving">Texto para grabado</label><input id="Engraving" name="properties[Texto de grabado]" maxlength="60" placeholder="Hasta 60 caracteres"></div>{% endif %}<div class="field"><label for="ProductQuantity">Cantidad</label><input id="ProductQuantity" name="quantity" type="number" min="1" value="1"></div><p class="form-error" data-form-error role="alert" hidden></p><button class="button" type="submit"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ section.settings.button_label | escape }}{% else %}Agotado{% endif %}</button><p class="muted">*Los métodos disponibles se muestran en el checkout según la configuración de pagos de tu tienda.</p></form></div></div></pet-product-form>
{% schema %}{"name":"Producto principal","settings":[{"type":"checkbox","id":"show_description","label":"Mostrar descripción","default":true},{"type":"checkbox","id":"enable_species","label":"Campo especie","default":true},{"type":"checkbox","id":"enable_name","label":"Campo nombre","default":true},{"type":"checkbox","id":"enable_photo","label":"Carga de foto de referencia","default":true},{"type":"checkbox","id":"enable_engraving","label":"Texto de grabado","default":true},{"type":"text","id":"button_label","label":"Texto del botón","default":"Añadir al carrito"}],"presets":[{"name":"Producto principal"}]}{% endschema %}
