<section class="page-width section-pad"><h1 class="section-heading">Tu carrito</h1>{% if cart.item_count == 0 %}<div class="empty-state"><p>Tu carrito está esperando una patita feliz.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explorar productos</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<article class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 160 | image_tag: width: 76, height: 76, alt: item.title | escape }}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.final_price | money }}</p>{% unless item.properties == empty %}<ul>{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% if property.last != blank and first_char != '_' %}<li>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">Ver archivo</a>{% else %}{{ property.last | escape }}{% endif %}</li>{% endif %}{% endfor %}</ul>{% endunless %}<label for="CartQty-{{ item.key }}">Cantidad</label><input id="CartQty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><p style="text-align:right;font-size:1.2rem">Subtotal: <strong>{{ cart.total_price | money }}</strong></p><div style="display:flex;justify-content:flex-end;gap:12px"><button class="button button--navy" type="submit" name="update">Actualizar carrito</button><button class="button" type="submit" name="checkout">Ir al pago</button></div></form>{% endif %}</section>
{% schema %}{"name":"Carrito principal","settings":[],"presets":[{"name":"Carrito principal"}]}{% endschema %}
