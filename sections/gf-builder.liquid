
{{ 'gf-styles.css' | asset_url | stylesheet_tag }}
<section class="gf-section gf-builder" id="gift-builder-{{ section.id }}"><div class="gf-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="gf-builder__head"><div class="gf-eyebrow" style="color:{{ section.settings.accent }}">✦ Módulo de personalización interactiva</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{%- assign builder_collection = section.settings.collection -%}<div class="gf-builder__layout" data-gf-builder data-gf-wrap-price="{{ section.settings.wrap_price | times: 100 }}"><div class="gf-steps"><div class="gf-step"><h3><b>1</b>{{ section.settings.step_1 }}</h3><div class="gf-builder__products">{%- if builder_collection != blank -%}{%- for product in builder_collection.products limit: 4 -%}<button type="button" class="gf-builder__product" data-gf-product="{{ product.selected_or_first_available_variant.id }}" data-gf-image="{{ product.featured_image | image_url: width: 600 }}" data-gf-name="{{ product.title | escape }}" data-gf-price="{{ product.price | money }}" data-gf-raw-price="{{ product.price }}"><img src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.title | escape }}"><strong>{{ product.title | truncate: 24 }}</strong><small>{{ product.price | money }}</small></button>{%- endfor -%}{%- else -%}<p>Selecciona una colección de productos personalizables.</p>{%- endif -%}</div></div><div class="gf-step"><h3><b>2</b>{{ section.settings.step_2 }}</h3><div class="gf-field"><label for="gf-engraving-{{ section.id }}">{{ section.settings.engraving_label }}</label><input id="gf-engraving-{{ section.id }}" data-gf-engraving type="text" name="properties[Grabado]" maxlength="30" value="{{ section.settings.engraving_default }}" placeholder="KODA, MI AMOR, LUNA..."></div></div><div class="gf-step"><h3><b>3</b>{{ section.settings.step_3 }}</h3><div class="gf-field"><label class="gf-check"><input type="checkbox" data-gf-wrap name="properties[Empaque de regalo]" data-gf-wrap-input value="{{ section.settings.wrap_label }}" checked><span>{{ section.settings.wrap_label }} <small>(+{{ section.settings.wrap_price | money_without_trailing_zeros }})</small></span></label><textarea data-gf-note name="properties[Dedicatoria]" placeholder="{{ section.settings.note_placeholder }}"></textarea></div></div></div><div class="gf-preview"><div class="gf-preview__top"><span>Vista previa en tiempo real</span><span class="gf-preview__ready">Listo para fabricación</span></div><div class="gf-preview__image"><img data-gf-preview-image src="{{ 'gf-placeholder.svg' | asset_url }}" alt="Vista previa del regalo"><div class="gf-preview__engraving" data-gf-preview-engraving>{{ section.settings.engraving_default }}</div></div><div class="gf-preview__summary"><span><span data-gf-preview-name>Selecciona una pieza</span><br>Creación personalizada</span><strong data-gf-preview-price>{{ 0 | money }}</strong></div><form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" data-gf-product-id value=""><input type="hidden" name="quantity" value="1"><input type="hidden" name="properties[Grabado]" data-gf-form-engraving value="{{ section.settings.engraving_default }}"><input type="hidden" name="properties[Empaque de regalo]" data-gf-form-wrap value="{{ section.settings.wrap_label }}"><input type="hidden" name="properties[Dedicatoria]" data-gf-form-note value=""><button class="gf-button gf-button--coral" type="submit" style="width:100%">{{ section.settings.button_label }} →</button></form></div></div></div></section>
<script>document.addEventListener('input',function(e){if(e.target.matches('[data-gf-engraving]')){var i=e.target.closest('[data-gf-builder]');var h=i&&i.querySelector('[data-gf-form-engraving]');if(h)h.value=e.target.value;}if(e.target.matches('[data-gf-note]')){var n=e.target.closest('[data-gf-builder]');var nh=n&&n.querySelector('[data-gf-form-note]');if(nh)nh.value=e.target.value;}});document.addEventListener('change',function(e){if(e.target.matches('[data-gf-wrap-input]')){var b=e.target.closest('[data-gf-builder]');var h=b&&b.querySelector('[data-gf-form-wrap]');if(h)h.value=e.target.checked?e.target.value:'';}});</script>
{% schema %}{"name":"GF · Arma tu regalo","tag":"section","settings":[{"type":"text","id":"heading","label":"Título","default":"Arma tu regalo en 3 pasos"},{"type":"textarea","id":"subheading","label":"Descripción","default":"Elige la pieza, añade tu grabado y termina con un empaque que cuenta la historia."},{"type":"collection","id":"collection","label":"Colección de productos personalizables"},{"type":"text","id":"step_1","label":"Paso 1","default":"Elige la pieza base"},{"type":"text","id":"step_2","label":"Paso 2","default":"Personaliza con tu grabado"},{"type":"text","id":"step_3","label":"Paso 3","default":"Empaque y mensaje"},{"type":"text","id":"engraving_label","label":"Etiqueta de grabado","default":"Nombre o dedicatoria que se grabará"},{"type":"text","id":"engraving_default","label":"Grabado inicial","default":"LUNA & KODA"},{"type":"text","id":"wrap_label","label":"Texto del empaque","default":"Caja rígida azul noche, listón coral y sello de cera"},{"type":"number","id":"wrap_price","label":"Precio del empaque","default":149},{"type":"text","id":"note_placeholder","label":"Placeholder de dedicatoria","default":"Dedicatoria para la tarjeta de regalo..."},{"type":"text","id":"button_label","label":"Botón","default":"Agregar mi creación a la bolsa"},{"type":"color","id":"accent","label":"Acento","default":"#E06A55"},{"type":"range","id":"padding_top","label":"Espacio superior","min":24,"max":120,"step":8,"default":88},{"type":"range","id":"padding_bottom","label":"Espacio inferior","min":24,"max":120,"step":8,"default":96}],"presets":[{"name":"GF · Arma tu regalo"}]}{% endschema %}
