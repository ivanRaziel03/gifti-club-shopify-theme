{% if section.settings.announcement != blank %}<div class="announcement">{{ section.settings.announcement | escape }}{% if section.settings.show_shipping_progress %} · Envío gratis desde {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}{% endif %}</div>{% endif %}
<header class="site-header"><div class="page-width header-inner"><a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ section.settings.brand_text | escape }}</a><div class="header-actions"><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="HeaderSearch">Buscar</label><input id="HeaderSearch" type="search" name="q" placeholder="Busca un regalo…" value="{{ search.terms | escape }}"><button type="submit" aria-label="Buscar">⌕</button></form>{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}<localization-form><form method="post" action="{{ routes.localization_url }}" class="localization-form">{% if localization.available_countries.size > 1 %}<label class="visually-hidden" for="CountrySelector">País</label><select id="CountrySelector" name="country_code" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="visually-hidden" for="LanguageSelector">Idioma</label><select id="LanguageSelector" name="locale_code" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endif %}<input type="hidden" name="return_to" value="{{ request.path }}"></form></localization-form>{% endif %}<a href="{{ routes.account_url }}">Cuenta</a><a class="cart-toggle" href="{{ routes.cart_url }}" data-open-cart aria-label="Abrir carrito">Carrito <span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a></div></div></header>
{% schema %}{"name":"Encabezado","settings":[{"type":"text","id":"brand_text","label":"Nombre visible","default":"PERRIJO & GATIJO"},{"type":"text","id":"announcement","label":"Anuncio","default":"Detalles hechos para consentir a tu mejor amigo"},{"type":"checkbox","id":"show_shipping_progress","label":"Mostrar umbral de envío","default":true}],"presets":[{"name":"Encabezado"}]}{% endschema %}
