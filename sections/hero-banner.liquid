<section class="hero"><div class="page-width hero-inner"><div><p class="muted" style="color:var(--mint);font-weight:800;letter-spacing:.12em;text-transform:uppercase">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.subheading | escape }}</p>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><div class="hero-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 760px) 45vw, 100vw', fetchpriority: 'high', alt: section.settings.image.alt | escape }}{% else %}<div style="height:360px;display:grid;place-items:center;color:var(--mint);font-size:6rem" aria-hidden="true">🐶<span>🐱</span></div>{% endif %}</div></div></section>
{% schema %}{"name":"Banner principal","settings":[{"type":"text","id":"eyebrow","label":"Texto superior","default":"Hecho para los consentidos"},{"type":"text","id":"heading","label":"Titular","default":"Regalos con huellitas de amor."},{"type":"textarea","id":"subheading","label":"Descripción","default":"Personaliza planners, prendas y accesorios con la personalidad única de tu Perrijo o Gatijo."},{"type":"image_picker","id":"image","label":"Imagen principal"},{"type":"text","id":"button_label","label":"Texto del botón","default":"Encuentra su regalo"},{"type":"url","id":"button_link","label":"Enlace del botón"}],"presets":[{"name":"Banner principal"}]}{% endschema %}
