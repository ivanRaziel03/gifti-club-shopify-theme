<section class="page-width section-pad"><h2 class="section-heading">{{ section.settings.title | escape }}</h2>{% assign featured_collection = collections[section.settings.collection] %}{% if featured_collection != blank %}<div class="collection-grid">{% for product in featured_collection.products limit: section.settings.products_to_show %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 640 | image_tag: widths: '240, 360, 480, 640', sizes: '(min-width: 760px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | escape }}{% endif %}<h3>{{ product.title | escape }}</h3></a><p>{{ product.price | money }}</p></article>{% endfor %}</div><p><a class="button button--navy" href="{{ featured_collection.url }}">Ver colección</a></p>{% else %}<p>Elige una colección en la configuración de esta sección para mostrar productos.</p>{% endif %}</section>
{% schema %}{"name":"Colección destacada","settings":[{"type":"text","id":"title","label":"Título","default":"Favoritos de la manada"},{"type":"collection","id":"collection","label":"Colección"},{"type":"range","id":"products_to_show","label":"Productos","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Colección destacada"}]}{% endschema %}
