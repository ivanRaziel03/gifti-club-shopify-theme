<section class="page-width section-pad"><h1 class="section-heading">Buscar</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchPage">Buscar productos</label><input id="SearchPage" name="q" type="search" value="{{ search.terms | escape }}" placeholder="¿Qué estás buscando?"><input type="hidden" name="options[prefix]" value="last"><button type="submit">Buscar</button></form>{% if search.performed %}<h2>Resultados para “{{ search.terms | escape }}”</h2>{% paginate search.results by 12 %}<div class="collection-grid">{% for item in search.results %}<article class="product-card"><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 640 | image_tag: widths: '240, 360, 480, 640', loading: 'lazy', alt: item.featured_image.alt | escape }}{% endif %}<h3>{{ item.title | escape }}</h3></a>{% if item.price %}<p>{{ item.price | money }}</p>{% endif %}</article>{% else %}<p>No encontramos resultados. Intenta con otra palabra.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Búsqueda","settings":[],"presets":[{"name":"Búsqueda"}]}{% endschema %}
