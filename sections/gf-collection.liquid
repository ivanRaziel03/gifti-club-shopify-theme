
{{ 'gf-styles.css' | asset_url | stylesheet_tag }}
<section class="gf-section gf-catalog" id="catalogo-{{ section.id }}"><div class="gf-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="gf-catalog__head"><div><div class="gf-eyebrow" style="color:{{ section.settings.accent }}">● {{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p class="gf-catalog__sub">{{ section.settings.subheading }}</p></div><a class="gf-button" style="background:{{ section.settings.button_color }};color:#fff" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} →</a></div>{%- assign chosen_collection = section.settings.collection -%}<div class="gf-product-grid">{%- if chosen_collection != blank and chosen_collection.products_count > 0 -%}{%- for product in chosen_collection.products limit: section.settings.products_to_show -%}{%- render 'gf-product-card', product: product -%}{%- endfor -%}{%- else -%}<div style="grid-column:1/-1;padding:30px;border:1px dashed #cfd5df;border-radius:18px;text-align:center;color:#6f7889">Selecciona una colección en el editor visual para mostrar tus regalos reales.</div>{%- endif -%}</div></div></section>
{% schema %}{"name":"GF · Catálogo destacado","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Etiqueta","default":"Selección Gifti"},{"type":"text","id":"heading","label":"Título","default":"Regalos que se sienten personales"},{"type":"textarea","id":"subheading","label":"Descripción","default":"Piezas curadas para celebrar mascotas, recuerdos y personas favoritas."},{"type":"collection","id":"collection","label":"Colección"},{"type":"range","id":"products_to_show","label":"Productos","min":2,"max":12,"step":1,"default":8},{"type":"text","id":"button_label","label":"Botón","default":"Ver todo el catálogo"},{"type":"color","id":"accent","label":"Color de acento","default":"#E06A55"},{"type":"color","id":"button_color","label":"Color del botón","default":"#0B1B3D"},{"type":"range","id":"padding_top","label":"Espacio superior","min":24,"max":120,"step":8,"default":72},{"type":"range","id":"padding_bottom","label":"Espacio inferior","min":24,"max":120,"step":8,"default":80}],"presets":[{"name":"GF · Catálogo destacado"}]}{% endschema %}
