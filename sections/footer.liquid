<footer class="footer"><div class="page-width"><div class="footer-grid"><div><a class="brand" style="color:white" href="{{ routes.root_url }}">{{ section.settings.brand_text | escape }}</a><p>{{ section.settings.description | escape }}</p>{% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" rel="me">Instagram</a>{% endif %}{% if settings.facebook_url != blank %} · <a href="{{ settings.facebook_url }}" rel="me">Facebook</a>{% endif %}<p>{{ settings.contact_email | escape }}</p></div><div><h3>Ayuda</h3><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div><div><h3>Buenas noticias</h3><p>Ideas y novedades para consentirlo más.</p>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Correo electrónico</label><input id="NewsletterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Tu correo" required><button type="submit">Suscribirme</button>{% if form.posted_successfully? %}<p>¡Gracias por suscribirte!</p>{% endif %}{% if form.errors %}<div>{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div></div></footer>
{% schema %}{"name":"Pie de página","settings":[{"type":"text","id":"brand_text","label":"Nombre","default":"PERRIJO & GATIJO"},{"type":"textarea","id":"description","label":"Descripción","default":"Regalos personalizados para los integrantes más peludos de la familia."},{"type":"link_list","id":"menu","label":"Menú de ayuda"}],"presets":[{"name":"Pie de página"}]}{% endschema %}
